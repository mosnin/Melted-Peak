# OS files
.DS_Store
Thumbs.db

# Editor files
*.swp
*.swo
*~
.vscode/
.idea/

# Incoming staging area git repos (cloned repos have their own .git)
incoming/*/.git/

# Node modules if any project uses them
node_modules/

# Environment files (should never be committed)
.env
.env.local
.env.*.local

# Claude Code local settings (not committed)
.claude/settings.local.json

# Plugin cache
.claude/plugins/cache/

# Session-specific files
.claude/teams/
.claude/tasks/
